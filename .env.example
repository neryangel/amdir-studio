# כתובת האתר הקנונית (לקישורים קנוניים, sitemap ו-OpenGraph). [להשלמה] כשיהיה דומיין.
PUBLIC_SITE_URL=https://studio.amdir.example
# true = מציג גם פריטים שסומנו placeholder (חומר זמני). בבנייה רגילה: false.
PUBLIC_SHOW_PLACEHOLDERS=false
# true = מציג מתג סקירה קטן להשוואת כיווני העיצוב. לעולם לא בייצור.
PUBLIC_REVIEW_MODE=false
# נתיב בסיס, אם האתר מתארח בתת-תיקייה (למשל /review/). ברירת מחדל: /
PUBLIC_BASE_PATH=/
PUBLIC_LEAD_ENDPOINT=

# ---- Server-only (Vercel env vars, never PUBLIC_*) for api/lead ----
# LEAD_SECRET=<random 32+ chars>          # HMAC for the time-trap token + IP hash. Required in production.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...       # bypasses RLS: server only
# LEAD_TABLE=studio_leads
# RESEND_API_KEY=re_...
# LEAD_NOTIFY_FROM=AMDIR <leads@amdir.co.il>
# LEAD_NOTIFY_TO=<owner inbox>
# LEAD_DEV_JSONL=.leads/leads.jsonl        # local dev/tests only
