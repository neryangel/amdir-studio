---
import Base from '../layouts/Base.astro';
import DraftNotice from '../components/DraftNotice.astro';
import { TODO } from '../lib/config';
import { getSettings } from '../lib/content';

const s = await getSettings();
const todo = (what: string) => `${TODO} ${what}`;
---

<Base title="מדיניות פרטיות" description="איזה מידע האתר אוסף, למה, מי מקבל אותו, ומה הזכויות שלכם." path="/privacy/">
  <div class="wrap">
    <header class="page-head">
      <h1>מדיניות פרטיות</h1>
      <DraftNotice />
    </header>
    <div class="prose">
      <h2>מי אחראי על המידע</h2>
      <p>
        האתר מופעל על ידי {s.business.legalName ?? <span class="todo">{todo('שם העסק')}</span>}, עוסק מס׳
        {s.business.osekNumber ?? <span class="todo">{todo('מספר עוסק')}</span>}, בבעלות {s.ownerName}. לפניות בנושא
        פרטיות: {s.email ?? <span class="todo">{todo('אימייל')}</span>}.
      </p>

      <h2>איזה מידע נאסף</h2>
      <p>רק מה שאתם ממלאים בטופס הפנייה או בטופס ההצטרפות לפיילוט:</p>
      <ul>
        <li>שם</li>
        <li>טלפון או אימייל</li>
        <li>במה אפשר לעזור</li>
        <li>הפרטים שכתבתם על הפרויקט</li>
        <li>האישור שקראתם את המדיניות הזו, והאם ביקשתם לקבל עדכונים (בחירה נפרדת, לא חובה)</li>
      </ul>
      <p>האתר לא מבקש מספר תעודת זהות, ולא אוסף מידע נוסף מעבר לזה.</p>

      <h2>למה</h2>
      <p>
        כדי לחזור אליכם בעניין הפנייה. אם סימנתם שתרצו לקבל עדכונים, נשלח אליכם מדי פעם עדכון על עבודות ומוצרים חדשים,
        ותוכלו להסיר את עצמכם בכל עת.
      </p>

      <h2>האם חובה למסור את המידע</h2>
      <p>לא. אין חובה חוקית למסור את הפרטים. בלי דרך ליצור איתכם קשר לא נוכל לחזור אליכם.</p>

      <h2>מי מקבל את המידע</h2>
      <p>
        המידע נשמר אצל ספקי השירות שהאתר עובד איתם: ספק האחסון <span class="todo">{todo('שם הספק')}</span> וספק הדואר
        <span class="todo">{todo('שם הספק')}</span>. המידע לא נמכר ולא מועבר לאחרים לצורכי שיווק.
      </p>

      <h2>כמה זמן המידע נשמר</h2>
      <p><span class="todo">{todo('תקופת שמירה, למשל עד שנתיים מהפנייה האחרונה')}</span></p>

      <h2>עוגיות וכלי מדידה</h2>
      <p>
        האתר לא משתמש בעוגיות שיווק ולא בכלי מדידה (אנליטיקס). אם יתווסף כלי כזה בעתיד, הוא יופעל רק אחרי שתאשרו
        זאת במפורש. המשך גלישה לא ייחשב כהסכמה.
      </p>
      <p>
        סרטונים מ-YouTube, Vimeo או Bunny נטענים רק אחרי שלחצתם על הפעלה. מרגע זה חלה גם מדיניות הפרטיות של אותו
        שירות.
      </p>

      <h2>הזכויות שלכם</h2>
      <p>
        לפי חוק הגנת הפרטיות, יש לכם זכות לעיין במידע שנשמר עליכם, ולבקש לתקן או למחוק אותו. אפשר לפנות בכתובת
        {s.email ?? <span class="todo">{todo('אימייל')}</span>}.
      </p>

      <h2>אבטחה</h2>
      <p><span class="todo">{todo('תיאור קצר של אמצעי האבטחה אצל ספקי האחסון והדואר')}</span></p>

      <h2>עדכון אחרון</h2>
      <p><span class="todo">{todo('תאריך')}</span></p>
    </div>
  </div>
</Base>
