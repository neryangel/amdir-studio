---
import Base from '../layouts/Base.astro';
import DraftNotice from '../components/DraftNotice.astro';
import { TODO } from '../lib/config';
import { getSettings } from '../lib/content';

const s = await getSettings();
const a = s.accessibility;
const todo = (what: string) => `${TODO} ${what}`;
---

<Base
  title="הצהרת נגישות"
  description="הצהרת הנגישות של אתר AMDIR: התקן, ההתאמות שבוצעו, מגבלות ידועות ופרטי קשר בנושא נגישות."
  path="/accessibility/"
>
  <div class="wrap">
    <header class="page-head">
      <h1>הצהרת נגישות</h1>
      <DraftNotice />
    </header>
    <div class="prose">
      <h2>התקן</h2>
      <p>
        האתר נבנה במטרה לעמוד בתקן הישראלי ת״י 5568, המבוסס על הנחיות WCAG 2.1 ברמה AA, ובתקנות שוויון זכויות
        לאנשים עם מוגבלות (התאמות נגישות לשירות).
      </p>

      <h2>ההתאמות שבוצעו</h2>
      <ul>
        <li>האתר בעברית, מימין לשמאל, עם הגדרת שפה תקינה.</li>
        <li>קישור לדילוג ישיר לתוכן בתחילת כל עמוד.</li>
        <li>אפשר לנווט בכל האתר במקלדת, עם סימון פוקוס בולט.</li>
        <li>ניגודיות צבעים ברמה AA בשני מצבי התצוגה (בהיר וכהה).</li>
        <li>לכל תמונה שנושאת מידע יש טקסט חלופי. המערכת לא מאפשרת להוסיף תמונה בלי טקסט כזה.</li>
        <li>סרטונים לא מתחילים לבד, ואין קול בלי לחיצה. סרטונים שמתארחים באתר כוללים כתוביות בעברית.</li>
        <li>אם הגדרתם במכשיר הפחתת תנועה, האתר מוצג בלי אנימציות.</li>
        <li>בטפסים: תווית מעל כל שדה, הודעת שגיאה מתחת לשדה, ומעבר אוטומטי לשדה הראשון שצריך תיקון.</li>
        <li>מבנה כותרות ואזורי עמוד (landmarks) תקין, לקוראי מסך.</li>
        <li>האתר לא משתמש בתוסף נגישות חיצוני. ההתאמות בנויות בקוד עצמו.</li>
      </ul>

      <h2>מגבלות ידועות ודרכים חלופיות</h2>
      <ul>
        <li>
          בסרטונים שמעבירים מידע (ולא רק מוזיקה ותמונה), יופיע בעמוד העבודה תיאור טקסטואלי של מה שרואים. אם חסר תיאור
          כזה, אפשר לבקש אותו בפרטי הקשר שבהמשך.
        </li>
        <li>
          נגני וידאו חיצוניים (YouTube, Vimeo, Bunny) נטענים מהספק, והנגישות שלהם תלויה בו. אפשר לבקש קובץ כתוביות או
          תמלול.
        </li>
        <li><span class="todo">{todo('מגבלות נוספות שיתגלו בבדיקה ידנית')}</span></li>
      </ul>

      <h2>פנייה בנושא נגישות</h2>
      <p>נתקלתם בבעיה? אשמח לשמוע ולתקן.</p>
      <ul>
        <li>שם: {a.contactName ?? <span class="todo">{todo('שם')}</span>}</li>
        <li>אימייל: {a.contactEmail ?? <span class="todo">{todo('אימייל')}</span>}</li>
        <li>טלפון: {a.contactPhone ?? <span class="todo">{todo('טלפון')}</span>}</li>
      </ul>

      <h2>בדיקה אחרונה</h2>
      <p>
        ההצהרה עודכנה והאתר נבדק לאחרונה בתאריך {a.lastReviewed ?? <span class="todo">{todo('תאריך')}</span>}. הבדיקה
        כללה בדיקה אוטומטית (axe) ובדיקה ידנית במקלדת.
      </p>
    </div>
  </div>
</Base>
