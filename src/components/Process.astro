---
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps?: Step[] | undefined;
  headingId?: string;
  heading?: string;
  /** Optional intro line under the heading. */
  lead?: string | undefined;
  /** Optional "read more" link under the steps, e.g. to /process/. */
  more?: { href: string; label: string } | undefined;
}
const defaults: Step[] = [
  { title: 'שיחת היכרות', text: 'מה המטרה, למי זה מיועד ומה כבר קיים.' },
  { title: 'הצעה ותכנון', text: 'היקף, לוח זמנים ומחיר בכתב, לפני שמתחילים.' },
  { title: 'עבודה עם נקודות אישור', text: 'גרסה לבדיקה בכל שלב מוסכם.' },
  { title: 'מסירה וליווי', text: 'קבצים סופיים, הדרכה ותקופת תיקונים מוגדרת.' },
];
const { steps = defaults, headingId = 'process-title', heading = 'איך עובדים יחד', lead, more } = Astro.props;
---

<section class="section" aria-labelledby={headingId}>
  <div class="section__head">
    <h2 class="h2" id={headingId}>{heading}</h2>
    {lead ? <p class="lead">{lead}</p> : null}
  </div>
  <ol class="steps">
    {
      steps.map((s) => (
        <li>
          <strong>{s.title}</strong>
          <span>{s.text}</span>
        </li>
      ))
    }
  </ol>
  {
    more ? (
      <p class="section__more">
        <a class="link-arrow" href={more.href}>
          {more.label}
        </a>
      </p>
    ) : null
  }
</section>
