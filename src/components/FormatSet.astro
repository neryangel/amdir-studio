---
// Format variants as one set: every frame keeps its real aspect ratio and all share one baseline,
// so a 16:9 master, a 9:16 cut and a 1:1 cut read as the same piece delivered three ways.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ASPECT_LABEL, aspectKey, type Aspect } from '../lib/enums';

interface Props {
  formats: { aspect: Aspect; image: ImageMetadata; alt: string; note?: string | undefined }[];
}
const { formats } = Astro.props;
---

<ul class="formats" role="list">
  {
    formats.map((f) => (
      <li class:list={['fmt', `fmt--${aspectKey(f.aspect)}`]}>
        <figure>
          <div class="fmt__frame">
            <Picture
              src={f.image}
              alt={f.alt}
              formats={['avif', 'webp']}
              widths={[320, 640, 960, 1200]}
              sizes="(max-width: 600px) 100vw, 50vw"
            />
          </div>
          <figcaption class="fmt__cap">
            <span class="fmt__ratio" dir="ltr">{f.aspect}</span>
            <span>{ASPECT_LABEL[f.aspect]}</span>
            {f.note ? <span class="fmt__note">{f.note}</span> : null}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
