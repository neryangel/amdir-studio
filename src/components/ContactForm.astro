---
// Accessible lead form, shared by /contact and the pilot form on the product page.
// Labels above inputs, errors below, aria-invalid + aria-describedby, focus moves to the first error.
// Submission goes through src/lib/lead.ts (submitLead). With no backend it never claims success.
import { getSettings } from '../lib/content';
import { url, whatsappHref } from '../lib/url';
import { EVENTS_PER_YEAR, EVENTS_PER_YEAR_LABEL, SITE_GOALS, SITE_GOAL_LABEL } from '../lib/lead-shared';

interface Props {
  variant?: 'contact' | 'pilot';
  /** Unique id prefix if two forms ever share a page. */
  idPrefix?: string;
}
const { variant = 'contact', idPrefix = variant } = Astro.props;
const settings = await getSettings();
const wa = whatsappHref(settings.whatsappNumber) ?? url('/contact/#whatsapp');
const id = (name: string) => `${idPrefix}-${name}`;

const needs =
  variant === 'pilot'
    ? [{ value: 'pilot', label: 'הצטרפות לפיילוט של Event Pro Studio' }]
    : [
        { value: 'clip', label: 'קליפ לשיר' },
        { value: 'video', label: 'עריכה, מושן או אפקטים' },
        { value: 'ai', label: 'קליפ או תמונות ב-AI' },
        { value: 'web', label: 'אתר' },
        { value: 'pilot', label: 'הפיילוט של Event Pro Studio' },
        { value: 'other', label: 'משהו אחר' },
      ];
const detailsLabel = variant === 'pilot' ? 'ספרו בקצרה על העבודה שלכם' : 'פרטים';
const detailsHelp =
  variant === 'pilot'
    ? 'למשל: אילו אירועים אתם מצלמים, ומה הייתם רוצים לשפר בתהליך העבודה.'
    : 'מה המטרה, ומה כבר קיים. אם יש תאריך יעד, כתבו גם אותו.';
// Need-specific groups. Without JS all are visible (with legends); with JS only the matching one.
const groups = variant === 'pilot' ? (['pilot'] as const) : (['media', 'web', 'pilot'] as const);
const GROUP_TITLE = { media: 'על הקליפ או הסרטון', web: 'על האתר', pilot: 'על העבודה שלכם' } as const;
---

<form class="form" data-lead-form data-form={variant} data-wa={wa} data-reply={settings.replyTime} novalidate>
  <div class="field">
    <label for={id('name')}>שם <span class="req">(חובה)</span></label>
    <input id={id('name')} name="name" autocomplete="name" required aria-describedby={id('name-err')} aria-errormessage={id('name-err')} />
    <p class="error" id={id('name-err')} data-error-for="name"></p>
  </div>

  <div class="field">
    <label for={id('reach')}>טלפון או אימייל <span class="req">(חובה)</span></label>
    <input
      id={id('reach')}
      name="reach"
      inputmode="email"
      autocomplete="email"
      dir="ltr"
      required
      aria-describedby={`${id('reach-help')} ${id('reach-err')}`}
      aria-errormessage={id('reach-err')}
    />
    <p class="help" id={id('reach-help')}>מספיק אחד מהשניים.</p>
    <p class="error" id={id('reach-err')} data-error-for="reach"></p>
  </div>

  <div class="field field--full">
    <label for={id('need')}>במה אפשר לעזור? <span class="req">(חובה)</span></label>
    <select id={id('need')} name="need" required aria-describedby={id('need-err')} aria-errormessage={id('need-err')}>
      {variant === 'pilot' ? null : <option value="">בחירה מהרשימה</option>}
      {needs.map((n) => <option value={n.value}>{n.label}</option>)}
    </select>
    <p class="error" id={id('need-err')} data-error-for="need"></p>
    <p class="visually-hidden" aria-live="polite" data-brief-live></p>
  </div>

  {
    groups.map((g) => (
      <fieldset class="brief field--full" data-brief-group={g} data-title={GROUP_TITLE[g]}>
        <legend>
          {GROUP_TITLE[g]} <span class="req">(לא חובה)</span>
        </legend>
        {g === 'media' ? (
          <div class="brief__grid">
            <div class="field field--full">
              <label for={id('brief-songUrl')}>קישור לשיר או לחומר</label>
              <input id={id('brief-songUrl')} name="brief.songUrl" type="url" inputmode="url" dir="ltr" autocomplete="off" aria-describedby={`${id('brief-songUrl-help')} ${id('brief-songUrl-err')}`} aria-errormessage={id('brief-songUrl-err')} />
              <p class="help" id={id('brief-songUrl-help')}>YouTube, Spotify, Drive או כל קישור אחר.</p>
              <p class="error" id={id('brief-songUrl-err')} data-error-for="brief.songUrl" />
            </div>
            <div class="field">
              <label for={id('brief-releaseDate')}>תאריך יציאה משוער</label>
              <input id={id('brief-releaseDate')} name="brief.releaseDate" type="month" dir="ltr" aria-describedby={`${id('brief-releaseDate-help')} ${id('brief-releaseDate-err')}`} aria-errormessage={id('brief-releaseDate-err')} />
              <p class="help" id={id('brief-releaseDate-help')}>חודש ושנה, למשל 2026-03.</p>
              <p class="error" id={id('brief-releaseDate-err')} data-error-for="brief.releaseDate" />
            </div>
            <div class="field">
              <label for={id('brief-referenceUrl')}>סגנון או רפרנס (קישור)</label>
              <input id={id('brief-referenceUrl')} name="brief.referenceUrl" type="url" inputmode="url" dir="ltr" autocomplete="off" aria-describedby={`${id('brief-referenceUrl-help')} ${id('brief-referenceUrl-err')}`} aria-errormessage={id('brief-referenceUrl-err')} />
              <p class="help" id={id('brief-referenceUrl-help')}>קליפ או עבודה שאהבתם, אם יש.</p>
              <p class="error" id={id('brief-referenceUrl-err')} data-error-for="brief.referenceUrl" />
            </div>
          </div>
        ) : g === 'web' ? (
          <div class="brief__grid">
            <div class="field field--full">
              <label for={id('brief-currentSiteUrl')}>יש לכם אתר היום? קישור</label>
              <input id={id('brief-currentSiteUrl')} name="brief.currentSiteUrl" type="url" inputmode="url" dir="ltr" autocomplete="url" aria-describedby={`${id('brief-currentSiteUrl-help')} ${id('brief-currentSiteUrl-err')}`} aria-errormessage={id('brief-currentSiteUrl-err')} />
              <p class="help" id={id('brief-currentSiteUrl-help')}>אם אין אתר, השאירו ריק.</p>
              <p class="error" id={id('brief-currentSiteUrl-err')} data-error-for="brief.currentSiteUrl" />
            </div>
            <div class="field">
              <label for={id('brief-siteGoal')}>מה המטרה העיקרית?</label>
              <select id={id('brief-siteGoal')} name="brief.siteGoal">
                <option value="">בחירה</option>
                {SITE_GOALS.map((v) => <option value={v}>{SITE_GOAL_LABEL[v]}</option>)}
              </select>
            </div>
            <div class="field">
              <label for={id('brief-desiredDate')}>מועד רצוי לעלייה לאוויר</label>
              <input id={id('brief-desiredDate')} name="brief.desiredDate" type="month" dir="ltr" aria-describedby={`${id('brief-desiredDate-help')} ${id('brief-desiredDate-err')}`} aria-errormessage={id('brief-desiredDate-err')} />
              <p class="help" id={id('brief-desiredDate-help')}>חודש ושנה, למשל 2026-09.</p>
              <p class="error" id={id('brief-desiredDate-err')} data-error-for="brief.desiredDate" />
            </div>
          </div>
        ) : (
          <div class="brief__grid">
            <div class="field">
              <label for={id('brief-eventsPerYear')}>כמה אירועים בשנה, בערך?</label>
              <select id={id('brief-eventsPerYear')} name="brief.eventsPerYear">
                <option value="">בחירה</option>
                {EVENTS_PER_YEAR.map((v) => <option value={v}>{EVENTS_PER_YEAR_LABEL[v]}</option>)}
              </select>
            </div>
            <div class="field">
              <label for={id('brief-currentTools')}>באילו כלים אתם משתמשים היום?</label>
              <input id={id('brief-currentTools')} name="brief.currentTools" maxlength="300" autocomplete="off" aria-describedby={id('brief-currentTools-help')} />
              <p class="help" id={id('brief-currentTools-help')}>למשל: גלריה אונליין, גיליון אקסל, וואטסאפ.</p>
            </div>
          </div>
        )}
      </fieldset>
    ))
  }

  <div class="field field--full">
    <label for={id('details')}>{detailsLabel} <span class="req">(חובה)</span></label>
    <textarea
      id={id('details')}
      name="details"
      required
      maxlength="4000"
      aria-describedby={`${id('details-help')} ${id('details-err')}`}
      aria-errormessage={id('details-err')}
    ></textarea>
    <p class="help" id={id('details-help')}>{detailsHelp}</p>
    <p class="error" id={id('details-err')} data-error-for="details"></p>
  </div>

  <div class="notice" id={id('notice')}>
    <p>
      <strong>מה קורה עם הפרטים:</strong> הפרטים משמשים רק כדי לחזור אליכם בעניין הפנייה. מסירת הפרטים היא
      לפי רצונכם, ואין חובה חוקית למסור אותם. הפרטים נשמרים אצל ספקי האחסון והדואר שהאתר עובד איתם, ורק
      לצורך הזה.
    </p>
    <p>
      יש לכם זכות לעיין בפרטים שנשמרו עליכם ולבקש לתקן אותם. פרטים נוספים ב<a href={url('/privacy/')}
        >מדיניות הפרטיות</a
      >.
    </p>
  </div>

  <div class="field field--full">
    <div class="check">
      <input
        type="checkbox"
        id={id('privacy')}
        name="privacyConsent"
        required
        aria-describedby={`${id('notice')} ${id('privacy-err')}`}
        aria-errormessage={id('privacy-err')}
      />
      <label for={id('privacy')}>
        קראתי את <a href={url('/privacy/')}>מדיניות הפרטיות</a>, ואפשר להשתמש בפרטים שלי כדי לענות על הפנייה. <span
          class="req">(חובה)</span
        >
      </label>
    </div>
    <p class="error" id={id('privacy-err')} data-error-for="privacyConsent"></p>
  </div>

  <div class="field field--full">
    <div class="check">
      <input type="checkbox" id={id('marketing')} name="marketingOptIn" />
      <label for={id('marketing')}>
        אשמח לקבל מדי פעם עדכונים על עבודות ומוצרים חדשים. <span class="req">(לא חובה, אפשר להסיר בכל עת)</span>
      </label>
    </div>
  </div>

  <div class="hp" aria-hidden="true">
    <label for={id('website')}>אתר אינטרנט (להשאיר ריק)</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <button class="btn btn--primary" type="submit">{variant === 'pilot' ? 'שליחת בקשה לפיילוט' : 'שליחה'}</button>
  </div>

  <div class="form-status" id={id('status')} role="status" aria-live="polite"></div>
  <noscript>
    <p class="form-status">
      הטופס עדיין לא מחובר, והוא דורש JavaScript. בינתיים אפשר לפנות <a href={wa}>בוואטסאפ</a>.
    </p>
  </noscript>
</form>

<script>
  import { isReach, prefetchToken, submitLead, type FailReason, type LeadPayload } from '../lib/lead';
  import {
    BRIEF_GROUPS,
    LEAD_NEEDS,
    MONTH_OR_DATE,
    briefGroupFor,
    isHttpUrl,
    type BriefField,
    type LeadNeed,
  } from '../lib/lead-shared';

  const URL_FIELDS = new Set<string>(['songUrl', 'referenceUrl', 'currentSiteUrl']);
  const MONTH_FIELDS = new Set<string>(['releaseDate', 'desiredDate']);
  const URL_ERROR = 'זה לא נראה כמו קישור. למשל: https://youtu.be/...';
  const MONTH_ERROR = 'חודש ושנה בפורמט 2026-03.';

  /** "youtu.be/x" → "https://youtu.be/x". Leaves anything else as typed. */
  function normalizeUrl(v: string): string {
    const t = v.trim();
    if (!t || /^[a-z][a-z0-9+.-]*:/i.test(t)) return t;
    return /^[^\s/]+\.[^\s/]+/.test(t) ? `https://${t}` : t;
  }

  const MESSAGES: Record<string, string> = {
    name: 'נא למלא שם.',
    reach: 'נא למלא טלפון או אימייל שאפשר לחזור אליו.',
    reachInvalid: 'זה לא נראה כמו טלפון או אימייל. לדוגמה: 050-0000000 או name@example.com',
    need: 'נא לבחור במה אפשר לעזור.',
    details: 'נא לכתוב כמה מילים על הפרויקט.',
    privacyConsent: 'כדי לשלוח צריך לאשר את מדיניות הפרטיות.',
  };
  // Server field names → form field names
  const FIELD_MAP: Record<string, string> = {
    contact: 'reach',
    name: 'name',
    need: 'need',
    details: 'details',
    privacyConsent: 'privacyConsent',
    'brief.songUrl': 'brief.songUrl',
    'brief.referenceUrl': 'brief.referenceUrl',
    'brief.currentSiteUrl': 'brief.currentSiteUrl',
    'brief.releaseDate': 'brief.releaseDate',
    'brief.desiredDate': 'brief.desiredDate',
  };

  const FAIL_TEXT: Record<FailReason, string> = {
    'not-connected': 'הטופס עדיין לא מחובר. בינתיים אפשר לפנות ',
    network: 'לא הצלחנו להתחבר לשרת, והפרטים לא נשלחו. אפשר לנסות שוב, או לפנות ',
    server: 'השליחה לא הצליחה, והפרטים לא נשמרו. אפשר לנסות שוב בעוד כמה דקות, או לפנות ',
    'too-fast': 'רגע אחד. נסו לשלוח שוב בעוד כמה שניות, או פנו ',
    'rate-limited': 'נשלחו כבר כמה פניות מהחיבור הזה. אפשר לנסות שוב מאוחר יותר, או לפנות ',
    invalid: 'יש שדות לתיקון. אפשר גם לפנות ',
  };

  function setError(form: HTMLFormElement, name: string, message: string) {
    const field = form.elements.namedItem(name);
    const err = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (field instanceof HTMLElement) {
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    }
    if (err) err.textContent = message;
  }

  function showStatus(status: HTMLElement, build: (p: HTMLParagraphElement) => void, focus: boolean) {
    status.replaceChildren();
    const p = document.createElement('p');
    build(p);
    status.append(p);
    if (focus) {
      status.tabIndex = -1;
      status.focus();
    }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    prefetchToken();
    const status = form.querySelector<HTMLElement>('.form-status[role="status"]');
    const isPilot = form.dataset.form === 'pilot';
    const groups = Array.from(form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-brief-group]'));
    const live = form.querySelector<HTMLElement>('[data-brief-live]');
    const activeGroup = () => (isPilot ? 'pilot' : briefGroupFor((form.elements.namedItem('need') as HTMLSelectElement | null)?.value ?? ''));

    // Progressive disclosure: only the group that matches "במה אפשר לעזור" stays visible.
    // Focus stays on the select; the change is announced in a polite live region.
    function syncGroups(announce: boolean) {
      const active = activeGroup();
      let shown: HTMLFieldSetElement | undefined;
      for (const g of groups) {
        const on = g.dataset.briefGroup === active;
        g.hidden = !on;
        if (on) shown = g;
      }
      if (announce && live) live.textContent = shown ? `נוספו שאלות ${shown.dataset.title ?? ''}. הן לא חובה.` : '';
    }
    syncGroups(false);
    form.querySelector('select[name="need"]')?.addEventListener('change', () => syncGroups(true));
    const get = (n: string) => {
      const el = form.elements.namedItem(n);
      return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement
        ? el
        : null;
    };

    form.addEventListener('input', (e) => {
      const t = e.target;
      if (t instanceof HTMLElement && t.getAttribute('aria-invalid') === 'true' && 'name' in t) {
        setError(form, String((t as HTMLInputElement).name), '');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.busy === 'true') return;
      const name = get('name')?.value.trim() ?? '';
      const reach = get('reach')?.value.trim() ?? '';
      const need = get('need')?.value ?? '';
      const details = get('details')?.value.trim() ?? '';
      const privacy = (get('privacyConsent') as HTMLInputElement | null)?.checked ?? false;
      const marketing = (get('marketingOptIn') as HTMLInputElement | null)?.checked ?? false;
      const website = get('website')?.value ?? '';

      const errors: [string, string][] = [];
      if (!name) errors.push(['name', MESSAGES.name ?? '']);
      if (!reach) errors.push(['reach', MESSAGES.reach ?? '']);
      else if (!isReach(reach)) errors.push(['reach', MESSAGES.reachInvalid ?? '']);
      if (!(LEAD_NEEDS as readonly string[]).includes(need)) errors.push(['need', MESSAGES.need ?? '']);
      if (!details) errors.push(['details', MESSAGES.details ?? '']);
      if (!privacy) errors.push(['privacyConsent', MESSAGES.privacyConsent ?? '']);

      // Brief: only the visible group is sent; every field is optional.
      const group = activeGroup();
      const brief: Partial<Record<BriefField, string>> = {};
      const briefNames: string[] = [];
      if (group) {
        for (const field of BRIEF_GROUPS[group].fields) {
          const el = get(`brief.${field}`);
          if (!el) continue;
          briefNames.push(`brief.${field}`);
          let value = el.value.trim();
          if (!value) continue;
          if (URL_FIELDS.has(field)) {
            value = normalizeUrl(value);
            if (el instanceof HTMLInputElement) el.value = value;
            if (!isHttpUrl(value)) errors.push([`brief.${field}`, URL_ERROR]);
          } else if (MONTH_FIELDS.has(field) && !MONTH_OR_DATE.test(value)) {
            errors.push([`brief.${field}`, MONTH_ERROR]);
          }
          brief[field] = value;
        }
      }
      form.querySelectorAll<HTMLElement>('[data-error-for^="brief."]').forEach((e) => (e.textContent = ''));
      form.querySelectorAll('[name^="brief."][aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));

      ['name', 'reach', 'need', 'details', 'privacyConsent', ...briefNames].forEach((n) => setError(form, n, ''));
      errors.forEach(([n, m]) => setError(form, n, m));
      if (errors.length) {
        if (status) status.textContent = `יש ${errors.length === 1 ? 'שדה אחד' : `${errors.length} שדות`} לתיקון.`;
        const first = errors[0];
        if (first) (form.elements.namedItem(first[0]) as HTMLElement | null)?.focus();
        return;
      }

      const payload: LeadPayload = {
        source: form.dataset.form === 'pilot' ? 'pilot' : 'contact',
        name,
        contact: reach,
        need: need as LeadNeed,
        details,
        privacyConsent: true,
        marketingOptIn: marketing,
        website,
        ...(Object.keys(brief).length ? { brief } : {}),
      };
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = button?.textContent ?? '';
      form.dataset.busy = 'true';
      if (button) {
        button.setAttribute('aria-disabled', 'true');
        button.textContent = 'שולחים...';
      }
      const result = await submitLead(payload);
      form.dataset.busy = 'false';
      if (button) {
        button.removeAttribute('aria-disabled');
        button.textContent = label;
      }
      if (!status) return;

      if (result.ok) {
        const reply = form.dataset.reply;
        showStatus(
          status,
          (p) => {
            const strong = document.createElement('strong');
            strong.textContent = 'הפנייה התקבלה ונשמרה.';
            p.append(strong, ` אחזור אליכם ${reply ? `${reply}` : 'בהקדם'}, בטלפון או באימייל שהשארתם.`);
          },
          true,
        );
        form.dataset.state = 'sent';
        form.reset();
        syncGroups(false);
        return;
      }

      if (result.reason === 'invalid') {
        for (const f of result.fields ?? []) {
          const local = FIELD_MAP[f];
          if (local) setError(form, local, MESSAGES[local] ?? (local.startsWith('brief.') ? (/Url$/.test(local) ? URL_ERROR : MONTH_ERROR) : 'נא לבדוק את השדה.'));
        }
      }
      // Never claim success. Keep everything the visitor typed.
      const wa = form.dataset.wa ?? '#';
      showStatus(
        status,
        (p) => {
          p.append(FAIL_TEXT[result.reason]);
          const a = document.createElement('a');
          a.href = wa;
          a.textContent = 'בוואטסאפ';
          if (wa.startsWith('http')) {
            a.target = '_blank';
            a.rel = 'noopener';
          }
          p.append(a, '. מה שכתבתם נשאר בטופס.');
        },
        result.reason !== 'not-connected',
      );
      form.dataset.state = 'error';
    });
  });
</script>
