---
import { Picture } from 'astro:assets';
import TempBadge from './TempBadge.astro';
import TypeLabel from './TypeLabel.astro';
import { DISCIPLINE_LABEL } from '../lib/enums';
import { workTitle, type Work } from '../lib/content';
import { asset, url } from '../lib/url';

interface Props {
  work: Work;
  sizes?: string | undefined;
  headingLevel?: 'h2' | 'h3';
}
const { work, sizes = '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw', headingLevel = 'h3' } = Astro.props;
const d = work.data;
const Heading = headingLevel;
// Link name = the title only; type, disciplines and badges are its description.
const titleId = `card-${work.id}-title`;
const metaId = `card-${work.id}-meta`;
const preview = d.preview ? { mp4: asset(d.preview.mp4), webm: d.preview.webm ? asset(d.preview.webm) : undefined } : undefined;
---

<a class="work-card" href={url(`/work/${work.id}/`)} aria-labelledby={titleId} aria-describedby={metaId}>
  <div class="work-card__media">
    <Picture src={d.poster} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes={sizes} />
    {
      preview ? (
        <video
          class="work-card__preview"
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          aria-hidden="true"
          tabindex="-1"
          data-mp4={preview.mp4}
          data-webm={preview.webm}
        />
      ) : null
    }
  </div>
  <div>
    <Heading class="work-card__title" id={titleId}>{workTitle(work)}</Heading>
    <p class="work-card__meta" id={metaId}>
      <TypeLabel type={d.type} />
      <span><span class="visually-hidden">תחום: </span>{d.disciplines.map((x) => DISCIPLINE_LABEL[x]).join(', ')}</span>
      <TempBadge show={d.placeholder} />
      <TempBadge show={d.needsReview} label="ממתין לבדיקה" />
    </p>
  </div>
</a>

<script>
  import '../scripts/previews';
</script>
