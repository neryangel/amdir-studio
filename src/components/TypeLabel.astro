---
import { WORK_TYPE_LABEL, type WorkType } from '../lib/enums';
interface Props {
  type: WorkType;
}
const { type } = Astro.props;
---

<span class:list={['type-label', { 'type-label--client': type === 'client' }]}>
  <span class="visually-hidden">סוג העבודה: </span>{WORK_TYPE_LABEL[type]}
</span>
